# Server settings (docs/DEPLOY.md). Copy to .env on the server, then run scripts/init-secrets.sh
# to replace the placeholders with random secrets.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
ALLOWED_HOSTS=bills.whobrokeprod.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://bills.whobrokeprod.com
# The app is reachable only through the tunnel; this port is for checks on the server itself.
APP_BIND=127.0.0.1
APP_PORT=3020
# HTTPS is terminated by Cloudflare: redirect to HTTPS, secure cookies, HSTS, and trust X-Forwarded-Proto.
SECURE_SSL=true
TRUST_X_FORWARDED_PROTO=true
TIME_ZONE=America/Toronto
POSTGRES_DB=bill_tracker
POSTGRES_USER=bill_tracker
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://bill_tracker:replace-with-a-strong-password@db:5432/bill_tracker
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Set by scripts/set-tunnel-token.sh. Leave empty until the tunnel is created.
CLOUDFLARE_TUNNEL_TOKEN=
COMPOSE_PROFILES=
# Nightly backups (deploy/systemd). BACKUP_PUSH_URL is an optional Uptime Kuma push URL.
BACKUP_DIR=/var/backups/bill-tracker
BACKUP_KEEP=14
BACKUP_PUSH_URL=
